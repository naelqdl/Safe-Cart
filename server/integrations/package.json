{
  "name": "@awsbuilderloft/integrations",
  "private": true,
  "type": "module",
  "description": "Sponsor API clients (T11, K-integrations). Owner: hz.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "smoke": "npm run smoke:senso; npm run smoke:stripe; npm run smoke:sie",
    "smoke:senso": "tsx senso.smoke.ts",
    "smoke:stripe": "tsx stripe.smoke.ts",
    "smoke:sie": "tsx sie.smoke.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx seed/seed.ts",
    "seed:v2": "tsx seed/seed.ts --version spd=2",
    "gate": "tsx seed/gate.ts"
  },
  "dependencies": {
    "@superlinked/sie-sdk": "0.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
