# Optional. Leave empty to use the built-in mock agent.
# When set, /api/agent and /api/action forward to <url>/agent and <url>/action (no trailing slash).
AGENT_BACKEND_URL=

# Optional. Amplitude project API key (public by design; sent from the browser). Empty = analytics off.
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Optional. Demo bar ids; must match the backend seed (data/**). Empty = the built-in mock's ids.
NEXT_PUBLIC_DEMO_SALE_SKU=
NEXT_PUBLIC_DEMO_RECALL_ID=

# Optional. Merchant sandbox for the /refunds page (refund requests and store replies). Default http://localhost:3100.
MERCHANT_URL=
