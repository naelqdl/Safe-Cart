# Copy to .env (repo root) and fill in. Never commit .env.
SENSO_API_KEY=        # Senso API key with KB scope (docs.senso.ai/api-keys)
STRIPE_SECRET_KEY=    # Stripe SANDBOX key: sk_test_... (live keys are refused)
SIE_API_KEY=          # Superlinked SIE Serverless key: sk-sie-...
STATSIG_SERVER_KEY=   # Statsig server secret key (console > Settings > API Keys); getPolicy falls back to defaults without it
S2_URL=               # SingleStore: mysql://user:pass@host:3306/db (portal → Connect → Your App)
PERSONA_API_KEY=      # Persona SANDBOX key: step-up check before purchases over the auto-buy limit; optional (simulated without it)
PERSONA_TEMPLATE_ID=  # Persona inquiry template itmpl_...
ANTHROPIC_API_KEY=   # Claude writes decision rationales + refund-claim letters (never decides); optional
